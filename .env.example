# TrendSentinel SPA - example environment file.
#
# Copy to `.env` for local development. Never commit `.env`.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# The API this SPA talks to
# ---------------------------------------------------------------------------
# Vite bakes VITE_API_URL into the bundle at BUILD time, not at runtime: changing it means
# rebuilding (or restarting `npm run dev`), not just restarting a container.
#
# The origin the SPA is served from must also be allowed in the API's CORS_ORIGINS, or every
# request fails in the browser. That setting lives in the backend repository.
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# E2E smoke (`npm run test:e2e`)
# ---------------------------------------------------------------------------
# Where the served SPA lives. The smoke drives a real browser against a running stack and a
# running API; ADMIN_API_KEY is read from the shell, not from this file.
SPA_E2E_BASE_URL=http://localhost:5180

# ---------------------------------------------------------------------------
# docker compose
# ---------------------------------------------------------------------------
# Host port the SPA is published on by `docker compose up`.
FRONTEND_PORT=5180
