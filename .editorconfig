# EditorConfig keeps contributors' editors agreeing on whitespace basics.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# The SPA and its configuration files are Prettier-formatted at 2 spaces.
[*.{js,ts,vue,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so they are left alone.
trim_trailing_whitespace = false
